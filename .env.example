# =============================================================================
# ASHA Care — Environment configuration
# Copy this file to `.env` and fill in real values.  Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT (safe to expose — these are shipped in the browser bundle)
# -----------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=
# Supabase "anon" / publishable key. This is a PUBLIC key protected by RLS.
VITE_SUPABASE_ANON_KEY=

# Optional: Google Maps *browser* key, restricted by HTTP referrer.
# Only used to render an embedded static map preview. Directions links and
# nearby-facility search work without it.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# -----------------------------------------------------------------------------
# SERVER ONLY (secrets — NEVER prefix these with VITE_)
# These are read by `server/index.ts` and never reach the browser.
# -----------------------------------------------------------------------------
# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model used for structured clinical output.
GEMINI_MODEL=gemini-3.7-flash
# Tried in order if the primary model is overloaded (HTTP 429/503).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest

# Speech-to-text key. Works with any OpenAI-compatible /audio/transcriptions
# endpoint, so either of these is valid:
#   • OpenAI    — https://platform.openai.com/api-keys  (paid, whisper-1)
#   • Groq      — https://console.groq.com/keys         (free tier, whisper-large-v3)
OPENAI_API_KEY=
# Whisper model name, as the chosen provider spells it.
WHISPER_MODEL=whisper-large-v3-turbo
# Leave unset for OpenAI. For Groq: https://api.groq.com/openai/v1
WHISPER_BASE_URL=https://api.groq.com/openai/v1

# Google Maps server key with "Places API (New)" + "Distance Matrix" enabled.
GOOGLE_MAPS_API_KEY=

# Port for the API proxy. Vite proxies /api here (see vite.config.ts).
# Checked before the generic PORT so a dev harness that sets PORT for the web
# server cannot hijack the API port.
API_PORT=8787

# -----------------------------------------------------------------------------
# SEED SCRIPT ONLY (`npm run seed`)
# The service-role key bypasses RLS. Keep it out of the browser and out of git.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Passwords assigned to the demo accounts created by the seed script.
SEED_ASHA_PASSWORD=123456
SEED_PHC_PASSWORD=123456
